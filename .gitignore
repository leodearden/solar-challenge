# dark-factory orchestrator scratch — must never reach main
# .task/ in particular: if committed, it contaminates every future worktree.
.task/
.taskmaster/

# What runs leave at the root of the main checkout: the orchestrator's runtime state and abandoned
# worktrees, and simulation output. Anchored with a leading /, so a project directory of the same
# name deeper in the tree is still listed. Pinned by tests/unit/test_gitignore.py.
/data/
/.worktrees-orphaned/
/results/
